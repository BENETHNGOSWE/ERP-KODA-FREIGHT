 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 0,
 "html": "<div class=\"kf-doc\">\n<style>\n  .kf-doc { font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #222; }\n  .kf-head { display: flex; justify-content: space-between; border-bottom: 3px solid #1f4e79; padding-bottom: 10px; }\n  .kf-company h1 { font-size: 20px; margin: 0; color: #1f4e79; letter-spacing: 1px; }\n  .kf-company div { font-size: 11px; color: #555; }\n  .kf-title { text-align: right; }\n  .kf-title h2 { margin: 0; font-size: 18px; text-transform: uppercase; letter-spacing: 2px; }\n  .kf-title div { font-size: 11px; color: #555; }\n  table.kf-grid { width: 100%; border-collapse: collapse; margin-top: 14px; }\n  table.kf-grid th { background: #1f4e79; color: #fff; text-align: left; padding: 6px; font-size: 11px; }\n  table.kf-grid td { border-bottom: 1px solid #ddd; padding: 6px; vertical-align: top; }\n  table.kf-grid td.num, table.kf-grid th.num { text-align: right; }\n  .kf-box { border: 1px solid #cfd8e3; background: #f7f9fc; padding: 10px; margin-top: 12px; }\n  .kf-box h3 { margin: 0 0 6px; font-size: 11px; text-transform: uppercase; color: #1f4e79; letter-spacing: 1px; }\n  .kf-total { margin-top: 12px; width: 45%; margin-left: auto; }\n  .kf-total td { padding: 5px; border-bottom: 1px solid #e3e8ef; }\n  .kf-total td.num { text-align: right; }\n  .kf-total tr.grand td { font-weight: bold; font-size: 14px; border-top: 2px solid #1f4e79; border-bottom: none; }\n  .kf-sign { margin-top: 40px; display: flex; justify-content: space-between; }\n  .kf-sign div { width: 30%; border-top: 1px solid #333; padding-top: 5px; font-size: 11px; text-align: center; }\n  .kf-foot { margin-top: 24px; font-size: 10px; color: #777; text-align: center; }\n  .kf-note { font-size: 11px; color: #b03a2e; margin-top: 10px; }\n</style>\n\n<div class=\"kf-head\">\n  <div class=\"kf-company\">\n    <h1>{{ doc.company or _(\"KODA FREIGHT\") }}</h1>\n    <div>{{ frappe.db.get_value(\"Company\", doc.company, \"company_address\") or \"\" }}</div>\n    <div>{{ frappe.db.get_value(\"Company\", doc.company, \"phone_no\") or \"\" }}</div>\n  </div>\n  <div class=\"kf-title\">\n    <h2>Final Invoice</h2>\n    <div>{{ doc.name }} &nbsp;|&nbsp; {{ frappe.utils.formatdate(doc.posting_date) }}</div>\n  </div>\n</div>\n\n<div class=\"kf-box\">\n  <h3>Bill To</h3>\n  <strong>{{ doc.customer_name }}</strong>\n  {% set c = frappe.db.get_value(\"Customer\", doc.customer, [\"mobile_no\",\"tax_id\",\"customer_primary_address\"], as_dict=True) %}\n  <div>{{ c.mobile_no or \"\" }}</div>\n  <div>TIN: {{ c.tax_id or \"-\" }}</div>\n  <div>Due date: {{ frappe.utils.formatdate(doc.due_date) if doc.due_date else \"-\" }}</div>\n</div>\n\n<table class=\"kf-grid\">\n  <tr>\n    <th style=\"width:45%\">Description</th>\n    <th class=\"num\">Qty</th>\n    <th class=\"num\">Rate</th>\n    <th class=\"num\">Amount</th>\n  </tr>\n  {% for row in doc.items %}\n  <tr>\n    <td>{{ row.item_name or row.item_code }}<br><small>{{ row.description or \"\" }}</small></td>\n    <td class=\"num\">{{ \"%.4f\"|format(row.qty or 0) }} {{ row.uom or \"\" }}</td>\n    <td class=\"num\">{{ \"{:,.2f}\".format(row.rate or 0) }}</td>\n    <td class=\"num\">{{ \"{:,.2f}\".format(row.amount or 0) }}</td>\n  </tr>\n  {% endfor %}\n</table>\n\n<table class=\"kf-total\">\n  <tr><td>Subtotal</td><td class=\"num\">{{ \"{:,.2f}\".format(doc.total or 0) }}</td></tr>\n  {% for tax in doc.taxes %}\n  <tr><td>{{ tax.description }}</td><td class=\"num\">{{ \"{:,.2f}\".format(tax.tax_amount or 0) }}</td></tr>\n  {% endfor %}\n  <tr class=\"grand\"><td>Total</td><td class=\"num\">{{ doc.currency }} {{ \"{:,.2f}\".format(doc.grand_total or 0) }}</td></tr>\n  <tr><td>Paid</td><td class=\"num\">{{ \"{:,.2f}\".format(doc.grand_total - doc.outstanding_amount) }}</td></tr>\n  <tr class=\"grand\"><td>Balance Due</td><td class=\"num\">{{ doc.currency }} {{ \"{:,.2f}\".format(doc.outstanding_amount or 0) }}</td></tr>\n</table>\n\n<div class=\"kf-note\">Payment status: {{ doc.status }}. Cargo is released only after the balance due reaches zero.</div>\n\n<div class=\"kf-foot\">This document was generated by Kodafreight.</div>\n</div>",
 "idx": 0,
 "line_breaks": 0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
