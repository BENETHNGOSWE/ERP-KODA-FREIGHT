 "html": "<div class=\"kf\"><style>\n .kf{font-family:Helvetica,Arial,sans-serif;font-size:11px;color:#222}\n .kf-top{display:table;width:100%}.kf-top .l,.kf-top .r{display:table-cell;vertical-align:top;width:50%}\n .kf-top .r{text-align:right}.kf-title{font-size:24px;letter-spacing:3px;color:#1f4e79;font-weight:bold}\n .kf-co-name{font-size:14px;font-weight:bold;color:#1f4e79}.kf-co-line{font-size:10px;color:#444}\n .kf-bar{height:3px;background:#1f4e79;margin:8px 0 12px}\n .kf-label{font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#1f4e79;font-weight:bold}\n .kf-strong{font-size:12px;font-weight:bold}.kf-muted{color:#555}\n table.kf-items{width:100%;border-collapse:collapse;margin-top:10px}\n table.kf-items th{background:#1f4e79;color:#fff;font-size:10px;text-align:left;padding:6px}\n table.kf-items td{border-bottom:1px solid #dfe5ec;padding:6px}\n table.kf-items td.num,table.kf-items th.num{text-align:right}\n .kf-box{border:1px solid #cfd8e3;background:#f7f9fc;padding:8px 10px;margin-top:12px}\n .kf-box pre{margin:0;font-family:Helvetica,Arial,sans-serif;font-size:10px;white-space:pre-wrap}\n .kf-sign{display:table;width:100%;margin-top:26px}\n .kf-sign div{display:table-cell;width:33%;font-size:10px;padding-top:14px;border-top:1px solid #333}\n .kf-foot{position:fixed;bottom:-12mm;left:0;right:0;font-size:8px;color:#777;text-align:center;border-top:1px solid #ddd;padding-top:4px}\n</style>\n <div class=\"kf-top\">\n  <div class=\"l\"><div class=\"kf-title\">DELIVERY ORDER</div><div class=\"kf-muted\">{{ doc.name }}</div></div>\n  <div class=\"r\">\n   <div class=\"kf-co-name\">{{ doc.get(\"kf_company_name\") or \"\" }}</div>\n   {% if doc.get(\"kf_company_phone\") %}<div class=\"kf-co-line\">Office Phone: {{ doc.get(\"kf_company_phone\") }}</div>{% endif %}\n   {% if doc.get(\"kf_company_tin\") %}<div class=\"kf-co-line\">TIN Number: {{ doc.get(\"kf_company_tin\") }}</div>{% endif %}\n   {% if doc.get(\"kf_company_address\") %}<div class=\"kf-co-line\">{{ doc.get(\"kf_company_address\") }}</div>{% endif %}\n  </div>\n </div>\n <div class=\"kf-bar\"></div>\n <div class=\"kf-box\">\n  <div class=\"kf-label\">Consignee</div>\n  <div class=\"kf-strong\">{{ doc.customer_name or doc.customer }}</div>\n  <div class=\"kf-muted\">Invoice: {{ doc.sales_invoice }}{% if doc.get(\"release_order\") %} &nbsp;|&nbsp; Release Order: {{ doc.get(\"release_order\") }}{% endif %}</div>\n  <div class=\"kf-muted\">Destination: {{ doc.get(\"destination\") or \"\" }} &nbsp;|&nbsp; Godown: {{ doc.get(\"warehouse\") or \"\" }}</div>\n </div>\n <table class=\"kf-items\">\n  <thead><tr><th>Driver Name</th><th>Driver Phone</th><th>Vehicle Reg. No</th><th>Delivery Date</th><th>Status</th></tr></thead>\n  <tbody><tr>\n   <td>{{ doc.get(\"driver_name\") or \"\" }}</td>\n   <td>{{ doc.get(\"driver_number\") or \"\" }}</td>\n   <td>{{ doc.get(\"vehicle_reg_no\") or \"\" }}</td>\n   <td>{{ doc.get_formatted(\"delivery_date\") }}</td>\n   <td>{{ doc.get(\"delivery_status\") or \"\" }}</td>\n  </tr></tbody>\n </table>\n <div class=\"kf-sign\"><div>Godown keeper</div><div>Driver signature</div><div>Customer signature</div></div>\n <div class=\"kf-foot\">{{ doc.get(\"kf_company_name\") or \"\" }}\n   {% if doc.get(\"kf_company_address\") %} &nbsp;|&nbsp; {{ doc.get(\"kf_company_address\") }}{% endif %}\n   {% if doc.get(\"kf_company_phone\") %} &nbsp;|&nbsp; Tel: {{ doc.get(\"kf_company_phone\") }}{% endif %}\n </div>\n</div>",
