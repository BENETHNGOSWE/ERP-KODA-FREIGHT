 "html": "<div class=\"kf-doc\">\n<style>\n  .kf-doc { font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #222; }\n  .kf-head { display: flex; justify-content: space-between; border-bottom: 3px solid #1f4e79; padding-bottom: 10px; }\n  .kf-company h1 { font-size: 20px; margin: 0; color: #1f4e79; letter-spacing: 1px; }\n  .kf-company div { font-size: 11px; color: #555; }\n  .kf-title { text-align: right; }\n  .kf-title h2 { margin: 0; font-size: 18px; text-transform: uppercase; letter-spacing: 2px; }\n  .kf-title div { font-size: 11px; color: #555; }\n  table.kf-grid { width: 100%; border-collapse: collapse; margin-top: 14px; }\n  table.kf-grid th { background: #1f4e79; color: #fff; text-align: left; padding: 6px; font-size: 11px; }\n  table.kf-grid td { border-bottom: 1px solid #ddd; padding: 6px; vertical-align: top; }\n  table.kf-grid td.num, table.kf-grid th.num { text-align: right; }\n  .kf-box { border: 1px solid #cfd8e3; background: #f7f9fc; padding: 10px; margin-top: 12px; }\n  .kf-box h3 { margin: 0 0 6px; font-size: 11px; text-transform: uppercase; color: #1f4e79; letter-spacing: 1px; }\n  .kf-total { margin-top: 12px; width: 45%; margin-left: auto; }\n  .kf-total td { padding: 5px; border-bottom: 1px solid #e3e8ef; }\n  .kf-total td.num { text-align: right; }\n  .kf-total tr.grand td { font-weight: bold; font-size: 14px; border-top: 2px solid #1f4e79; border-bottom: none; }\n  .kf-sign { margin-top: 40px; display: flex; justify-content: space-between; }\n  .kf-sign div { width: 30%; border-top: 1px solid #333; padding-top: 5px; font-size: 11px; text-align: center; }\n  .kf-foot { margin-top: 24px; font-size: 10px; color: #777; text-align: center; }\n  .kf-note { font-size: 11px; color: #b03a2e; margin-top: 10px; }\n</style>\n\n<div class=\"kf-head\">\n  <div class=\"kf-company\">\n    <h1>{{ doc.company or _(\"KODA FREIGHT\") }}</h1>\n    <div>{{ frappe.db.get_value(\"Company\", doc.company, \"company_address\") or \"\" }}</div>\n    <div>{{ frappe.db.get_value(\"Company\", doc.company, \"phone_no\") or \"\" }}</div>\n  </div>\n  <div class=\"kf-title\">\n    <h2>Release Order</h2>\n    <div>{{ doc.name }} &nbsp;|&nbsp; {{ frappe.utils.formatdate(doc.release_date) }}</div>\n  </div>\n</div>\n\n<div class=\"kf-box\">\n  <h3>Released To</h3>\n  <strong>{{ doc.released_to }}</strong>\n  <div>Phone: {{ doc.customer_phone or \"-\" }}</div>\n  <div>ID / TIN: {{ doc.id_number or \"-\" }}</div>\n  <div>Customer: {{ doc.customer_name or doc.customer }}</div>\n</div>\n\n<table class=\"kf-grid\">\n  <tr><th>Invoice</th><th class=\"num\">Invoice Total</th><th class=\"num\">Outstanding</th><th>Packages</th><th>Godown</th></tr>\n  <tr>\n    <td>{{ doc.sales_invoice }}</td>\n    <td class=\"num\">{{ \"{:,.2f}\".format(doc.invoice_grand_total or 0) }}</td>\n    <td class=\"num\">{{ \"{:,.2f}\".format(doc.invoice_outstanding or 0) }}</td>\n    <td>{{ doc.packages_count or 0 }}</td>\n    <td>{{ doc.warehouse or \"-\" }}</td>\n  </tr>\n</table>\n\n<div class=\"kf-note\">\n  Verified: invoice {{ doc.sales_invoice }} is fully paid. The godown shall release the packages above\n  to the person named in this order only.\n</div>\n\n<div class=\"kf-sign\">\n  <div>Authorised by</div>\n  <div>Godown keeper</div>\n  <div>Customer signature</div>\n</div>\n\n<div class=\"kf-foot\">This document was generated by Kodafreight.</div>\n</div>",
